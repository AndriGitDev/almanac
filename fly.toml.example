# Almanac Fly.io example. Copy to fly.toml and choose your own app name.
#
# See https://fly.io/docs/reference/configuration/ for information about how to use this file.
#

app = 'your-almanac-app'
primary_region = 'fra'

[build]
  dockerfile = 'Dockerfile'

[env]
  ALMANAC_HOST = '0.0.0.0'
  ALMANAC_PORT = '8745'
  ALMANAC_TRANSPORT = 'streamable-http'
  ALMANAC_VAULT_PATH = '/vault'
  PYTHONPATH = '/app'

[[mounts]]
  source = 'vault_data'
  destination = '/vault'

[http_service]
  internal_port = 8745
  force_https = true
  auto_stop_machines = 'suspend'
  auto_start_machines = true
  min_machines_running = 0

[[vm]]
  memory = '1024mb'
  cpu_kind = 'shared'
  cpus = 1
  memory_mb = 1024
